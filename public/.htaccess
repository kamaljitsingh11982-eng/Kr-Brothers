DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonicalize route slash, host and scheme in one redirect where needed.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.krbrothers\.in$ [NC]
  RewriteRule ^(contact|equipment|service-areas|terms|services/[^/]+)$ https://www.krbrothers.in/$1/ [R=301,L,NE]

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.krbrothers\.in$ [NC]
  RewriteRule ^ https://www.krbrothers.in%{REQUEST_URI} [R=301,L,NE]
  RewriteRule ^(contact|equipment|service-areas|terms|services/[^/]+)$ /$1/ [R=301,L]
  RewriteRule ^assets/gallery/ - [E=GALLERY_CACHE:1]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header set Cache-Control "public, max-age=2592000" env=GALLERY_CACHE

  # Immutable caching is limited to Vite-hashed JavaScript and CSS bundles.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

# Enable HSTS only after the owner confirms HTTPS works for the domain.
# Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
